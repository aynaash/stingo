{
  "name": "stingo",
  "version": "0.1.0",
  "description": "Let your AI make the video. Declarative video for engineers: a script plus a taste profile render to MP4, with cuts that land on the beat and talking-head takes composited in.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "keywords": [
    "video",
    "video-generation",
    "motion-graphics",
    "mcp",
    "mcp-server",
    "ai",
    "agent",
    "ffmpeg",
    "satori",
    "svg",
    "mp4",
    "shorts",
    "youtube",
    "explainer",
    "declarative",
    "content-creation",
    "bun",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/stingo/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/stingo/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./media": {
      "types": "./dist/types/media/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stingo": "bin/stingo.ts",
    "stingo-mcp": "bin/stingo-mcp.ts"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "satori": "^0.33.4",
    "shiki": "^4.4.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  },
  "scripts": {
    "prepublishOnly": "cd ../.. && bun run tools/build.ts"
  },
  "homepage": "https://aynaash.github.io/stingo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aynaash/stingo.git",
    "directory": "packages/stingo"
  },
  "bugs": {
    "url": "https://github.com/aynaash/stingo/issues"
  },
  "author": "Hersi (https://github.com/aynaash)",
  "publishConfig": {
    "access": "public"
  }
}
