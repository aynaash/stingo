{
  "name": "stingo",
  "version": "0.1.0",
  "description": "Declarative video for people who ship content \u2014 SVG animations and MP4 from a typed script, with cuts that land on the beat.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "keywords": [
    "video",
    "animation",
    "svg",
    "mp4",
    "motion-graphics",
    "ffmpeg",
    "satori",
    "bun",
    "shorts",
    "explainer"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/stingo/src/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/types/stingo/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./media": {
      "bun": "./src/media.ts",
      "types": "./dist/types/media/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stingo": "./bin/stingo.ts"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@stingo/schema": "workspace:*",
    "@stingo/core": "workspace:*",
    "@stingo/render": "workspace:*",
    "@stingo/blocks": "workspace:*",
    "@stingo/themes": "workspace:*",
    "@stingo/film": "workspace:*",
    "@stingo/audio": "workspace:*",
    "@stingo/encode": "workspace:*",
    "@stingo/cli": "workspace:*",
    "@stingo/studio": "workspace:*",
    "@stingo/media": "workspace:*"
  },
  "scripts": {
    "prepublishOnly": "cd ../.. && bun run tools/build.ts"
  }
}
